{
  "name": "tiltr",
  "version": "2.5.1",
  "private": true,
  "type": "module",
  "description": "Das unsichtbare Labyrinth – ein immersives Sensor-Spiel als PWA",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "node e2e/smoke.mjs",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"e2e/**/*.mjs\" \"*.{ts,json,md}\""
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "playwright": "^1.45.0",
    "prettier": "^3.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "jsqr": "^1.4.0",
    "trystero": "^0.25.3",
    "uqr": "^0.1.3",
    "zod": "^4.5.2"
  }
}
